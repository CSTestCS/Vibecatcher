{
  "name": "vibecatcher",
  "productName": "Vibecatcher",
  "version": "1.0.0",
  "description": "Transparent always-on-top overlay that detects on-screen humanoid characters and drives VRoid/VRM models to match them.",
  "main": "src/main/main.js",
  "author": "Vibecatcher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "fetch-models": "node scripts/fetch-models.js",
    "build:renderer": "node scripts/build-renderer.js",
    "build": "npm run fetch-models && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "node --test test/unit.test.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.vibecatcher.overlay",
    "productName": "Vibecatcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Vibecatcher-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Vibecatcher-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "@mediapipe/tasks-vision": "0.10.18",
    "@pixiv/three-vrm": "3.3.3",
    "three": "0.172.0"
  },
  "dependencies": {}
}
